<?xml version="1.0" encoding="utf-8"?>
<!--
  电视Agent(纯 Java,无第三方库)
  = 无障碍服务(在电视上替人点击/输入)+ 前台 HTTP 服务(手机同局域网直连 :9999 遥控)
  与小爱同学完全独立:所有会动电视界面的操作前先做小爱互斥守卫(isXiaoAiOnTop)。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tv.agent">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 真指针反馈:tap/swipe 起止点闪现悬浮小圆点(真机用 adb appops 授权) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <application
        android:label="电视Agent"
        android:icon="@drawable/ic_stat"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <!-- 状态页:onCreate 即拉起 HttpService;按返回退出界面,服务常驻 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 无障碍执行器:替人点击 / 输入 / 合成手势 -->
        <service
            android:name=".AgentService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_service_config"/>
        </service>

        <!-- 前台 HTTP 服务:specialUse 类型,常驻监听 9999 端口 -->
        <service
            android:name=".HttpService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="tv-remote-agent"/>
        </service>
    </application>

    <!-- Android 11+ 包可见性:能看到所有带 LAUNCHER 入口的应用,
         否则 getLaunchIntentForPackage 对未声明可见性的包返回 null -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
